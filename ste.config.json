{
  "$schema": "./node_modules/@mark1russell7/ste-lint/ste.config.schema.json",
  "include": [
    "README.md",
    "CLAUDE.md",
    "RELEASING.md",
    "docs/**/*.{md,mdx}",
    "packages/*/README.md",
    "packages/site/**/*.{md,mdx}",
    "packages/*/src/**/*.{ts,tsx}",
    "packages/*/*.config.{ts,mts}"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "technicalNouns": [
    "capability",
    "classifier",
    "container",
    "context",
    "document",
    "evaluator",
    "focus",
    "kind",
    "ladder",
    "path",
    "rung",
    "schedule",
    "sequence",
    "shape",
    "tag",
    "verb"
  ],
  "technicalVerbs": ["evaluate", "derive", "tag"],
  "properNouns": [
    "ASD",
    "ASD-STE100",
    "Astro",
    "AWS Step Functions",
    "Claude",
    "coeval",
    "GitHub",
    "GitHub Actions",
    "GitHub Pages",
    "JastAdd",
    "JetBrains MPS",
    "JSON",
    "Kernel",
    "pnpm",
    "Simplified Technical English",
    "TSDoc",
    "TypeScript",
    "npm",
    "OIDC",
    "SemVer",
    "Mark"
  ]
}
